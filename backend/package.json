{
  "name": "production-auth-system",
  "version": "1.0.0",
  "description": "Production-ready authentication system with multi-device logout, admin controls, and rate limiting",
  "main": "app.js",
  "scripts": {
    "generate-tests": "node auto-test-agent/index.js",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "rbac:setup": "node src/seed/setupDatabase.js setup",
    "rbac:reset": "node src/seed/setupDatabase.js reset",
    "rbac:test": "node src/seed/Rbacseeder.js test",
    "rbac:stats": "node src/seed/setupDatabase.js stats",
    "rbac:admin": "node src/seed/setupDatabase.js create-admin",
    "rbac:help": "node src/seed/setupDatabase.js help",
    "rbac:reset-users": "node src/seed/resetUsersAndRbac.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize-cli db:migrate:status"
  },
  "keywords": [
    "authentication",
    "jwt",
    "redis",
    "session-management",
    "rate-limiting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "faker": "^5.5.3",
    "firebase-admin": "^13.8.0",
    "fluent-ffmpeg": "^2.1.3",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jose": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.16.2",
    "node-input-validator": "^4.6.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.6",
    "redis": "^4.6.11",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0",
    "swagger-autogen": "^2.23.7",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
