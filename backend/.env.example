# ─── Azure Blob Storage (account: lcmscode) ──────────────────────────────────
# Portal: Storage account lcmscode → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=lcmscode

# Client setup: ONE container "lcms-data" (Container public read) — recommended
AZURE_CONTAINER_DEFAULT=lcms-data
# Files go inside as: images/..., videos/..., documents/..., audio/...

# OR separate containers (only if you create more in Portal):
# AZURE_CONTAINER_IMAGES=images
# AZURE_CONTAINER_VIDEOS=videos

AZURE_STORAGE_PUBLIC_BASE_URL=https://lcmscode.blob.core.windows.net
AZURE_STORAGE_ENABLED=true

# Chunk upload (frontend 5MB parts)
UPLOAD_CHUNK_SIZE_MB=5
UPLOAD_MAX_CHUNK_MB=10
